FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ghostscript \
    software-properties-common \
    ca-certificates \
  && add-apt-repository -y ppa:qpdf/qpdf && apt-get update \
  && apt-get install -y qpdf \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/optimize-pdf.sh /app/optimize-pdf.sh
RUN chmod +x /app/optimize-pdf.sh